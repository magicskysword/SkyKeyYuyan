<Project>
  <!--
    dotnet/ 下所有 C# 项目的公共设置。
    该文件刻意不放在仓库根目录：MSBuild 会逐级向上查找 Directory.Build.props，
    放在根目录时 Unity 生成的 csproj 在 IDE 中构建也会导入它。
  -->
  <PropertyGroup>
    <SkyRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</SkyRepoRoot>
    <SkyUnityPackagesDir>$(SkyRepoRoot)unity/SkyKeyYuyan.Unity/Packages/</SkyUnityPackagesDir>

    <Version>0.2.0</Version>
    <Authors>MagicSkySword</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>纯托管多语言输入、文本编辑与独立会话框架</Description>
    <PackageOutputPath>$(SkyRepoRoot)artifacts/NuGet/</PackageOutputPath>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- 发布到 NuGet 和 UPM 的库项目 -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- 测试项目 -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
</Project>
