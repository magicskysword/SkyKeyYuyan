<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SkyPackageVersion Condition="'$(SkyPackageVersion)' == ''">0.2.0</SkyPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkyKeyYuyan.Core" Version="$(SkyPackageVersion)" />
    <PackageReference Include="SkyKeyYuyan.Languages.Chinese" Version="$(SkyPackageVersion)" />
    <PackageReference Include="SkyKeyYuyan.Languages.English" Version="$(SkyPackageVersion)" />
    <PackageReference Include="SkyKeyYuyan.Languages.Korean" Version="$(SkyPackageVersion)" />
  </ItemGroup>
</Project>
